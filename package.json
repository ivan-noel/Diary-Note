{
  "name": "diary-note",
  "version": "1.0.0",
  "description": "Diary Note — a simple free notepad anyone can use",
  "main": "main.js",
  "author": "you",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.example.diarynote",
    "productName": "Diary Note",
    "files": ["main.js", "preload.js", "index.html", "style.css", "script.js", "assets/icon.ico"],
    "win": { "target": "nsis", "icon": "assets/icon.ico" },
    "mac": { "target": "dmg" },
    "linux": { "target": "AppImage" }
  }
}
